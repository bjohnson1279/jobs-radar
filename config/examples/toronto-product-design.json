      "aliases": [
        "CA",
        "CAN",
        "Canadian"
      ]
    },
    "allowMultiCountryRemote": false
  },
  "roles": {
    "includeTitlePattern": "\\bproduct designer\\b|\\bux designer\\b|\\bdesign manager\\b",
